{
  "name": "radical.tools.sdlc.demo.3.warehouse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@radicaltools/cli": "0.3.3",
    "@radicaltools/crucible": "^0.3.2",
    "@radicaltools/mcp": "0.3.3",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "yaml": "^2.8.0"
  },
  "description": "The Warehouse of radical.tools.sdlc.demo.3: one of the repositories that build one system, with one model.",
  "workspaces": [
    "packages/*",
